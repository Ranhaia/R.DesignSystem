# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*storybook.log
storybook-static

# vitest / playwright (addon-vitest)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# git worktrees isolados (superpowers:using-git-worktrees)
/.worktrees/
# estado dos jobs do AGY (um por worktree)
/.agy-staff/

# saída do graphify — regenerável de graça em ~40s com
# `graphify extract . --code-only && graphify cluster-only . --no-label`.
# graph.json (3 MB) e graph.html (2,3 MB) mudam por inteiro a cada extração.
/graphify-out/
.tsc-check.log

# projeto solto, sem relação com o design system (POC de vídeo de carta
# animada) — aninhado aqui por engano, decisão de mover pra pasta própria
# ainda pendente com o Rafael (2026-07-28)
/card-video-poc/
