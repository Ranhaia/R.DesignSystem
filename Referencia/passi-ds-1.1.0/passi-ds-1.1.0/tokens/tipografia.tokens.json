{
  "$description": "Estilos de texto do PASSI DS. Fontes gratuitas no Google Fonts: Archivo (títulos), Inter (textos) e IBM Plex Mono (rótulos técnicos e código). Família, peso e tamanho apontam para as variáveis da coleção Tipografia; o nome do tamanho e da entrelinha é o valor em px no Figma.",
  "fonte": {
    "titulos": {
      "$type": "fontFamily",
      "$value": [
        "Archivo",
        "sans-serif"
      ],
      "$description": "Títulos e display.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "FONT_FAMILY"
          ],
          "codeSyntax": {
            "WEB": "var(--fonte-titulos)"
          }
        }
      }
    },
    "textos": {
      "$type": "fontFamily",
      "$value": [
        "Inter",
        "sans-serif"
      ],
      "$description": "Textos corridos, rótulos e interface.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "FONT_FAMILY"
          ],
          "codeSyntax": {
            "WEB": "var(--fonte-textos)"
          }
        }
      }
    },
    "codigo": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Mono",
        "monospace"
      ],
      "$description": "Código, sobretítulos e valores técnicos.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "FONT_FAMILY"
          ],
          "codeSyntax": {
            "WEB": "var(--fonte-codigo)"
          }
        }
      }
    }
  },
