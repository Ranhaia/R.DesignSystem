        "value": 80,
        "unit": "ms"
      },
      "$extensions": {
        "com.figma": {
          "scopes": [],
          "codeSyntax": {
            "WEB": "var(--duracao-instantanea)"
          }
        }
      }
    },
    "rapida": {
      "$type": "duration",
      "$value": {
